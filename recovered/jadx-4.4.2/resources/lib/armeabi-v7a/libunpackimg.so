#!/system/bin/sh
# AIK-mobile/unpackimg: split image and unpack ramdisk
# osm0sis @ xda-developers
# slightly modified by redlee90@gmail.com

bin="$1";
workdir="$2";

cleanup() { rm -rf $workdir/ramdisk $workdir/split_img $workdir/*new.*; }
abort() { cd "$bin"; echo "Error!"; }

if [ ! "$3" -o ! -f "$3" ]; then
  echo "No image file supplied.";
  abort;
  return 1;
fi;

case $3 in
  *\ *)
    echo "Filename contains spaces.";
    abort;
    return 1;;
esac;

bb="$bin/busybox";

cd "$bin";

clear;

file=$($bb basename $3);
echo "Supplied image: $file\n";

if [ -d $workdir/split_img -o -d $workdir/ramdisk ]; then
  echo "Removing old work folders and files...\n";
  cleanup;
fi;

echo "Setting up work folders...\n";
mkdir $workdir/split_img $workdir/ramdisk;

echo 'Splitting image to "split_img/"...';
cd "$workdir/split_img";
$bin/unpack -i "$3";
if [ $? != "0" ]; then
  cleanup;
  abort;
  return 1;
fi;

cd $workdir/split_img;
$bin/file -m $bin/magic *-ramdisk.gz | $bb cut -d: -f2 | $bb cut -d" " -f2 > "$file-ramdiskcomp";
ramdiskcomp=$(cat *-ramdiskcomp);
unpackcmd="$bb $ramdiskcomp -dc";
compext=$ramdiskcomp;
case $ramdiskcomp in
  gzip) compext=gz; extra="-c";;
  lzop) compext=lzo;;
  xz) ;;
  lzma) ;;
  bzip2) compext=bz2;;
  lz4) unpackcmd="$bin/lz4 -dq"; extra="stdout";;
  *) compext="";;
esac;
if [ "$compext" ]; then
  compext=.$compext;
fi;
mv "$file-ramdisk.gz" "$file-ramdisk.cpio$compext";
cd ..;

echo '\nUnpacking ramdisk to "ramdisk/"...\n';
cd ramdisk;
echo "Compression used: $ramdiskcomp";
if [ ! "$compext" ]; then
  abort;
  return 1;
fi;
$unpackcmd "../split_img/$file-ramdisk.cpio$compext" $extra | $bb cpio -idmv;
if [ $? != "0" ]; then
  abort;
  return 1;
fi;
cd ..;

echo "\nDone!";
return 0;

